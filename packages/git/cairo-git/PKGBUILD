pkgbase=cairo-git
pkgname=(cairo-git)
pkgver=1.18.4.r141.gdd6262c17
pkgrel=2
pkgdesc="2D graphics library with support for multiple output devices"
url="https://cairographics.org/"
arch=(x86_64)
license=('LGPL-2.1-only OR MPL-1.1')
depends=(
  bash
  fontconfig
  freetype2
  glib2
  glibc
  libpng
  libx11
  libxcb
  libxext
  libxrender
  lzo
  pixman
  zlib
)
makedepends=(
  git
  meson
  valgrind
)
source=("git+https://gitlab.freedesktop.org/cairo/cairo.git")
sha256sums=('SKIP')

pkgver() {
  cd cairo
  git describe --tags | sed 's/[^-]*-g/r&/;s/-/./g'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  local meson_options=(
    -D dwrite=disabled
    -D gtk_doc=false
    -D spectre=disabled
    -D symbol-lookup=disabled
    -D b_ndebug=true
  )

  local _final_cflags="$CFLAGS"
  local _final_cxxflags="$CXXFLAGS"

  # Phase 1: PGO instrumented build (tests enabled for training)
  CFLAGS+=" -fprofile-generate" CXXFLAGS+=" -fprofile-generate"
  arch-meson cairo build "${meson_options[@]}" \
    -D tests=enabled \
    -D b_lto=false
  meson compile -C build

  # Phase 2: training — run test suite
  timeout -k 5 120 meson test -C build --print-errorlogs || true

  # Phase 3: verify profile quality
  local _gcda_count
  _gcda_count="$(find build -name '*.gcda' 2>/dev/null | wc -l)"
  if ((_gcda_count < 50)); then
    warning "PGO produced only %d gcda files — rebuilding with LTO only" "$_gcda_count"
    CFLAGS="$_final_cflags"
    CXXFLAGS="$_final_cxxflags"
    meson setup --reconfigure cairo build \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS"
    meson configure build -D tests=disabled -Db_lto=true
    meson compile -C build
  else
    msg "PGO profile: %d gcda files — rebuilding with profile" "$_gcda_count"
    CFLAGS="$_final_cflags -fprofile-use=$(pwd)/build"
    CXXFLAGS="$_final_cxxflags -fprofile-use=$(pwd)/build"
    meson setup --reconfigure cairo build \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS"
    meson configure build -D tests=disabled -Db_lto=true
    meson compile -C build
  fi

  local _binary
  while IFS= read -r -d '' _binary; do
    if readelf -sW "$_binary" 2>/dev/null | grep -Eq '__gcov_|__llvm_profile'; then
      error "final Cairo build still contains profile instrumentation: $_binary"
      return 1
    fi
  done < <(find build -type f \( -name '*.so' -o -name '*.so.*' -o -perm -u+x \) -print0)
}

package_cairo-git() {
  provides=(
    libcairo-gobject.so
    libcairo-script-interpreter.so
    libcairo.so
  )
  provides+=("${pkgname%-git}=${pkgver%%.r*}")
  conflicts=("${pkgname%-git}")
  options+=(!emptydirs)

  meson install -C build --destdir "$pkgdir"
}

