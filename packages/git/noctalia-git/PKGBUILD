# strip:   makepkg strips the final binaries (STRIP_BINARIES="--strip-all")
# lto:     makepkg appends -flto=auto to CFLAGS/CXXFLAGS/LDFLAGS (belt & braces
#          with the explicit -Db_lto=true in build())
# !debug:  no separate debug package
