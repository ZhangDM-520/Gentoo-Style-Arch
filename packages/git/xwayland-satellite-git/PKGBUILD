# Maintainer: shtrophic <aur at shtrophic dot net>
# Contributor: Nebulosa <nebulosa2007-at-yandex-dot-ru>

_pkgname=xwayland-satellite
pkgname="$_pkgname-git"
pkgver=0.8.2.r13.gadd2795
pkgrel=2
pkgdesc="Xwayland outside your Wayland - git version"
arch=(x86_64)
url="https://github.com/Supreeeme/$_pkgname"
license=(MPL-2.0)
depends=(
	gcc-libs
	glibc
	libxcb
	xcb-util-cursor
	xorg-xwayland
)
makedepends=(
	git
	clang
	rust
)
provides=($_pkgname)
conflicts=($_pkgname)
source=(git+$url.git
        0001-round-half-up.patch)
b2sums=('SKIP'
        'f8202a7eeffa8febd08a4702796f951adca784c67bdce2dda6eff55830b90a701f938be97998c7285677fbea293ae888f0a1dd336c2a641f08248be15247bf08')

pkgver() {
	cd $_pkgname
	git describe --long --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
	cd $_pkgname
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_HOME="$srcdir"/.cargo

	# Fix blurry X11 windows under fractional scaling: round the logical -> device
	# conversion half-up instead of truncating, matching what compositors do with the
	# on-screen rect. Local until https://github.com/Supreeeme/$_pkgname/issues/479 lands.
	git apply -3 ../0001-round-half-up.patch

	sed 's|/usr/local|/usr|' -i resources/$_pkgname.service
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
	cd $_pkgname
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_HOME="$srcdir"/.cargo
	export CARGO_TARGET_DIR=target

	# Disable sccache
	unset RUSTC_WRAPPER

	# Append to RUSTFLAGS, don't clobber makepkg.conf's CachyOS defaults
	local _extra_rustflags="--remap-path-prefix=$srcdir=/"
	if ! echo "${RUSTFLAGS:-}" | grep -q 'target-cpu'; then
		_extra_rustflags+=" -C target-cpu=native"
	fi
	export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }$_extra_rustflags"

	# Use mold linker if available
	if command -v mold >/dev/null 2>&1; then
		export RUSTFLAGS+=" -C link-arg=-fuse-ld=mold"
	fi

	# Fat LTO + single codegen unit for best optimization
	export CARGO_PROFILE_RELEASE_LTO=fat
	export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
	export CARGO_PROFILE_RELEASE_STRIP=symbols

	cargo build --frozen --release --features systemd
}

check() {
	cd $_pkgname
	export XDG_RUNTIME_DIR="$(mktemp -d)"
	export RUSTUP_TOOLCHAIN=stable
	# Integration tests are flaky (race conditions) — run unit tests only
	cargo test --frozen --lib
}

package() {
	install -Dm644 $_pkgname/resources/$_pkgname.service -t "$pkgdir"/usr/lib/systemd/user/
	install -Dm755 $_pkgname/target/release/$_pkgname -t "$pkgdir"/usr/bin/
}
