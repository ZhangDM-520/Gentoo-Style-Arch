From 3c0a481ba9ab5484b6e72a11336e3689c9df42a8 Mon Sep 17 00:00:00 2001
From: ZhangDM-520 <jixianqiang1540@gmail.com>
Date: Sun, 20 Sep 2026 18:15:55 +0800
Subject: [PATCH] server: round logical -> device scaling half-up, not down

Compositors snap a window's on-screen rect to whole device pixels and round
half-up when they do (niri: round(dst * scale); GTK4 and Qt agree, as measured
from their fractional-scale requests). xwayland-satellite set the X11 window
size, which is the buffer size, by truncating the same conversion, so at
fractional scales the buffer could end up one device pixel smaller than the rect
the compositor draws. The compositor then rescales by (dst * scale) / device,
which reads as slightly blurry output and as a small loss of sharpness on every
glyph edge. At scale 1.25 this hits any logical width or height with
`logical % 4` in {2, 3}, which includes niri's default tiled geometry.

Round half-up on the configure path instead, and make `update_surface_viewport`
round half-up too. The latter is not optional: it derives the viewport
destination from the buffer size, so leaving it on `ceil()` would have the two
conversions be inconsistent inverses of each other and the destination would
drift by a pixel on each round trip, leaving the window blurry for a different
reason.

Add a regression test that asserts the round trip is the identity,
`device == round(dst * scale)`, for every residue of `logical * 1.25 mod 4`, and
that pins the intermediate values, so it fails on the truncating behaviour for
the sizes that the bug affects and passes for the sizes where truncating and
rounding happen to agree.

Reported in https://github.com/Supreeeme/xwayland-satellite/issues/479

Rebased onto 63cdf17 (the v0.8.3 bump). Upstream #448 (63cdf17) only rounds the
xdg_positioner size/anchor rect for popups, a different conversion, and #479 is
still open, so the fix is still needed. Upstream #496 (5274bdc) moved the
satellite-titlebar height reduction from `update_surface_viewport` into the
configure arm; the height conversion now rounds half-up there, and the
`client_side_decorations_fractional_scale` test that #496 added (which pinned
the truncating expectations) is updated to the same half-up rounding.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 src/server/event.rs |  28 +++++++++----
 src/server/tests.rs | 110 +++++++++++++++++++++++++++++++++++++++++++-
 2 files changed, 127 insertions(+), 11 deletions(-)

diff --git a/src/server/event.rs b/src/server/event.rs
index acf51d9..13e68aa 100644
--- a/src/server/event.rs
+++ b/src/server/event.rs
@@ -300,10 +300,18 @@ impl SurfaceEvents {
             let (scale_factor, window, window_data, role) = query.get().unwrap();
 
             let window = *window;
-            let x = (pending.x.max(0) as f64 * scale_factor.0) as i32 + window_data.output_offset.x;
-            let y = (pending.y.max(0) as f64 * scale_factor.0) as i32 + window_data.output_offset.y;
+            // Round the logical -> device conversion half-up instead of truncating, to match what
+            // compositors do with fractional scaling (they snap the on-screen rect to whole device
+            // pixels, rounding half-up). Truncating here would commit a buffer one device pixel
+            // smaller than the rect the compositor draws, so it rescales and the window looks
+            // slightly blurry. See the `fractional_scale_toplevel_device_size_matches_viewport`
+            // test. `f64::round` is half-away-from-zero, and the `as` casts saturate.
+            let x = (pending.x.max(0) as f64 * scale_factor.0).round() as i32
+                + window_data.output_offset.x;
+            let y = (pending.y.max(0) as f64 * scale_factor.0).round() as i32
+                + window_data.output_offset.y;
             let width = if pending.width > 0 {
-                (pending.width as f64 * scale_factor.0) as u16
+                (pending.width as f64 * scale_factor.0).round() as u16
             } else {
                 window_data.attrs.dims.width
             };
@@ -311,7 +319,9 @@ impl SurfaceEvents {
                 let mut logical_height = pending.height;
                 if let SurfaceRole::Toplevel(Some(toplevel)) = role {
                     if let Some(d) = &toplevel.decoration.satellite {
-                        let surface_width = (width as f64 / scale_factor.0).ceil() as i32;
+                        // Inverse of the device width computed above; must round the same way
+                        // `update_surface_viewport` does.
+                        let surface_width = (width as f64 / scale_factor.0).round() as i32;
                         if d.will_draw_decorations(surface_width) {
                             logical_height = (logical_height
                                 - DecorationsDataSatellite::TITLEBAR_HEIGHT)
@@ -319,7 +329,7 @@ impl SurfaceEvents {
                         }
                     }
                 }
-                (logical_height as f64 * scale_factor.0) as u16
+                (logical_height as f64 * scale_factor.0).round() as u16
             } else {
                 window_data.attrs.dims.height
             };
@@ -484,8 +494,12 @@ pub(super) fn update_surface_viewport(
     let dims = &window_data.attrs.dims;
     let size_hints = &window_data.attrs.size_hints;
 
-    let width = (dims.width as f64 / scale_factor.0).ceil() as i32;
-    let height = (dims.height as f64 / scale_factor.0).ceil() as i32;
+    // Invert the logical -> device scaling done in the configure handler (`event.rs`, the
+    // `xdg_surface::Event::Configure` arm): that side rounds half-up, so this side must round
+    // half-up too, or the viewport destination drifts by a pixel per round trip and the committed
+    // buffer no longer matches the rect the compositor draws.
+    let width = (dims.width as f64 / scale_factor.0).round() as i32;
+    let height = (dims.height as f64 / scale_factor.0).round() as i32;
     if width > 0 && height > 0 {
         viewport.set_destination(width, height);
     }
