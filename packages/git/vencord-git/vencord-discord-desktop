#!/bin/sh
# vencord-discord-desktop — (un)wrap the stock Discord launcher's Exec line.
#
# wrap:    Exec=/usr/bin/discord … -> Exec=/usr/bin/discord-vencord …
# restore: the reverse, for vencord-git pre_remove.
#
# Invoked bare by the libalpm hook (default file), by vencord-git.install,
# and with an explicit path by tests/vencord-inject.sh. Never ships or owns
# discord.desktop itself — editing a pacman-owned file's content in place is
# what keeps this package file-conflict-free, and both directions are
# idempotent: the patterns only match the exact unwrapped/wrapped forms, so
# `discord-vencord` can never double-wrap.
set -eu

mode=${1:-}
file=${2:-/usr/share/applications/discord.desktop}

case "$mode" in
wrap)
    [ -f "$file" ] || exit 0
    sed -i \
        -e 's|^Exec=/usr/bin/discord |Exec=/usr/bin/discord-vencord |' \
        -e 's|^Exec=/usr/bin/discord$|Exec=/usr/bin/discord-vencord|' \
        "$file"
    ;;
restore)
    [ -f "$file" ] || exit 0
    sed -i \
        -e 's|^Exec=/usr/bin/discord-vencord |Exec=/usr/bin/discord |' \
        -e 's|^Exec=/usr/bin/discord-vencord$|Exec=/usr/bin/discord|' \
        "$file"
    ;;
*)
    echo "usage: vencord-discord-desktop {wrap|restore} [desktop-file]" >&2
    exit 2
    ;;
esac
