#!/bin/sh
# discord-vencord — Discord launcher that re-asserts Vencord injection.
#
# The stock discord.desktop Exec line is redirected here by
# vencord-discord-desktop (post_install + the libalpm hook). Discord's
# self-updating bootstrap drops a pristine app.asar on every update, so the
# patch is re-asserted on every launch rather than trusting a one-shot
# install. Injection failure is non-fatal: Discord still starts, at worst
# without Vencord until the next launch.

if [ -x /usr/bin/vencord-inject ]; then
    /usr/bin/vencord-inject inject >/dev/null 2>&1 ||
        echo "discord-vencord: warning: could not assert Vencord injection" >&2
fi

exec /usr/bin/discord "$@"
