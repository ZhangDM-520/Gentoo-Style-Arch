#!/bin/sh
#
# /usr/share/libalpm/scripts/bpftune-restart
#
# bpftune dlopens its tuner plugins from /usr/lib/bpftune/*.so and keeps
# pointers into the mappings.  Replacing those files underneath the running
# process does not unmap anything, but it does leave the thread that is
# mid-lookup holding a pointer that no longer resolves, and it dies inside
# strstr() with SIGSEGV/SEGV_MAPERR.
#
# That is measured, not inferred.  /var/lib/systemd/coredump holds exactly two
# bpftune coredumps; they are the same fault at the same offset, and each one
# is stamped in the same second as the `pacman -U` of bpftune-git that rewrote
# the plugins:
#
#   2026-09-16 07:38:35  reinstall, crash in the same second
#   2026-09-16 18:57:50  reinstall, crash in the same second
#
# Both crashes did recover, because the unit is Restart=on-failure, but that
# still writes a 24 MB core per rebuild and leaves the unit's Result=failure,
# and a third restart inside StartLimitInterval would park it in
# start-limit-hit.  So the process must not span the swap at all: the recipe's
# pre-transaction hook stops it before the files change and its post-transaction
# hook starts it once they are consistent again.
#
# Usage: bpftune-restart {pre|post}

set -eu

unit=bpftune.service

# Records "the package install stopped this unit, so it owes starting it again".
# On tmpfs on purpose: a reboot voids the transaction anyway, and the unit is
# enabled, so boot starts it regardless.  The fixture overrides the path because
# a hook runs as root and a test does not.
marker=${BPFTUNE_SWAP_MARKER:-/run/bpftune-tuners-stopped}

case "${1:-}" in
pre)
	# A unit that is running has to come back once its plugins are consistent
	# again, and one sitting in `failed` -- start-limit-hit after an earlier
	# swap, say -- is the same case, because this install is the next chance
	# to bring it back.  A unit the user stopped deliberately is neither.
	if systemctl is-active --quiet "$unit" || systemctl is-failed --quiet "$unit"; then
		: >"$marker"
		systemctl stop "$unit"
	fi
	;;
post)
	if [ -e "$marker" ]; then
		# The pre half stopped it, so this half owes it a start.
		rm -f "$marker"
		systemctl start "$unit"
	else
		# The pre half did not run, which is what the transaction that installs
		# these hooks looks like: they are not on disk yet when PreTransaction
		# fires, so the unit spans that one swap and dies in it.  A
		# restart-if-running repairs that, and still cannot start a unit the
		# user stopped -- which is why this is not a plain start.
		systemctl try-restart "$unit"
	fi
	;;
*)
	printf 'usage: %s {pre|post}\n' "${0##*/}" >&2
	exit 1
	;;
esac
