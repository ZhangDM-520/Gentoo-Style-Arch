pkgname=libunwind-git
pkgver=1.8.3.r418.ge932b668
pkgrel=1
pkgdesc="Portable and efficient C programming interface (API) to determine the call-chain of a program"
arch=('i686' 'x86_64')
url="https://www.nongnu.org/libunwind/"
license=('MIT')
depends=('glibc' 'xz' 'zlib')
makedepends=('git')  # texlive-core dropped 2026-09-05: latex is only used for optional PDF docs
provides=("libunwind=$pkgver"
          'libunwind.so=8-64'
          'libunwind-x86_64.so=8-64'
          'libunwind-coredump.so=0-64'
          'libunwind-ptrace.so=0-64'
          'libunwind-setjmp.so=0-64')
conflicts=('libunwind')
options=('staticlibs')
# soname provides must be DECLARED explicitly (mirrors repo libunwind):
# makepkg 7's autodeps is disabled globally (makepkg.conf) and PKGBUILD lint
# rejects 'autodeps' in the options array; pacman does NOT derive soname
# provides from package files at -U time. Without these, gimp's
# 'libunwind.so=8-64' dep breaks on install. Bump on upstream soname change.
source=("git+https://github.com/libunwind/libunwind.git")
sha256sums=('SKIP')


pkgver() {
  cd "libunwind"

  _tag=$(git tag -l --sort -v:refname | grep -E '^v?[0-9\.]+$' | head -n1)
  _rev=$(git rev-list --count $_tag..HEAD)
  _hash=$(git rev-parse --short HEAD)
  printf "%s.r%s.g%s" "$_tag" "$_rev" "$_hash" | sed 's/^v//'
}

build() {
  cd "libunwind"

  autoreconf -fi
  ./configure \
    --prefix="/usr"
  make
}

check() {
  cd "libunwind"

  make check
}

package() {
  cd "libunwind"

  make DESTDIR="$pkgdir" install
  install -Dm644 "COPYING" -t "$pkgdir/usr/share/licenses/libunwind"
}
