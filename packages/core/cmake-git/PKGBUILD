# This PKGBUILD is based on the official Arch cmake package.

pkgname=cmake-git
pkgver=4.4.3.936.g2ee33f507d
pkgrel=1
pkgdesc='A cross-platform open-source make system'
arch=('x86_64')
url="http://www.cmake.org/"
license=('custom')
conflicts=('cmake')
provides=("cmake=${pkgver}")
depends=('curl' 'libarchive' 'hicolor-icon-theme' 'jsoncpp' 'libjsoncpp.so' 'libuv' 'rhash' 'cppdap')
makedepends=('python-sphinx' 'nlohmann-json' 'git')
optdepends=()
source=('git+https://gitlab.kitware.com/cmake/cmake.git'
        'cmake-cppflags.patch')
md5sums=('SKIP'
         'd7316e540d07e0a7ebce75951a7b2697')
#shortver=$(printf "${pkgver}" | sed 's/\([0-9]\+\.[0-9]\+\)\..*/\1/')

pkgver() {
    cd "$srcdir/cmake"
    git describe --always --tags --long | sed -e 's|^v||' -e 's|-|.|g'
}

prepare() {
    cd "$srcdir/cmake"
    patch -p1 -i ../cmake-cppflags.patch # Honor CPPFLAGS https://gitlab.kitware.com/cmake/cmake/issues/12928
}

# The bootstrap/configure step, in one place so the two PGO phases cannot drift
# apart. It reads CFLAGS/CXXFLAGS/LDFLAGS out of the environment, which is why
# phase 2 has to call it again (see build()).
bootstrap_cmake() {
  ./bootstrap --prefix=/usr \
    --mandir=/share/man \
    --docdir=/share/doc/cmake \
    --datadir=/share/cmake \
    --sphinx-man \
    --system-libs \
    --parallel="${GSA_BUILD_JOBS:-$(/usr/bin/getconf _NPROCESSORS_ONLN)}"
}

build() {
  cd "$srcdir/cmake"

  # Phase 1: Generate profile data
  export CFLAGS="$CFLAGS -fprofile-generate"
  export CXXFLAGS="$CXXFLAGS -fprofile-generate ${CPPFLAGS}"
  export LDFLAGS="$LDFLAGS -fuse-ld=mold -fprofile-generate"

  bootstrap_cmake
  make

  # Run cmake on a test project to generate profile data
  mkdir -p /tmp/cmake-pgo-test
  cat > /tmp/cmake-pgo-test/CMakeLists.txt << 'EOF'
cmake_minimum_required(VERSION 3.10)
project(pgo_test C CXX)
add_executable(hello main.cpp)
EOF
  cat > /tmp/cmake-pgo-test/main.cpp << 'EOF'
int main() { return 0; }
EOF
  ./bin/cmake -S /tmp/cmake-pgo-test -B /tmp/cmake-pgo-test/build 2>/dev/null || true
  rm -rf /tmp/cmake-pgo-test

  # Verify profile data
  local gcda_count=$(find . -name '*.gcda' | wc -l)
  if [ $gcda_count -eq 0 ]; then
    echo "Warning: No profile data generated, skipping PGO"
    return 0
  fi
  echo "Profile data generated: $gcda_count .gcda files"

  # Phase 2: Use profile data
  export CFLAGS="${CFLAGS/-fprofile-generate/-fprofile-use}"
  export CXXFLAGS="${CXXFLAGS/-fprofile-generate/-fprofile-use}"
  export LDFLAGS="${LDFLAGS/-fprofile-generate/-fprofile-use}"

  # Reconfiguring is mandatory, not tidiness: CMake reads CFLAGS/CXXFLAGS/LDFLAGS
  # only while it *initialises the cache*, and phase 1's bootstrap wrote that
  # cache with the phase-1 flags. `make clean` does not remove CMakeCache.txt, and
  # re-running configure with the cache still in place goes on ignoring the
  # environment — so the substitution above would be a no-op, `make` would relink
  # the instrumented objects, and the payload would stay a phase-1 build. That is
  # the 2026-09-20 failure: package() aborted on cmake/ccmake/cpack/ctest, all
  # four still carrying baked `.gcda` paths. The cache has to go for the new flags
  # to be read at all, hence clean -> purge -> reconfigure -> build.
  make clean
  rm -f CMakeCache.txt
  bootstrap_cmake
  make
}

package() {
  cd "$srcdir/cmake"
  make DESTDIR="${pkgdir}" install

  install -Dm644 LICENSE.rst -t "${pkgdir}"/usr/share/licenses/$pkgname
}
