#!/bin/bash -ex
# Highly opinionated wrapper for Arch Linux packaging -- feel free to edit this to your liking!

exec meson setup \
  --prefix        /usr \
  --libexecdir    lib \
  --sbindir       bin \
  --buildtype     release \
  --auto-features enabled \
  --wrap-mode     nodownload \
  -D              python.bytecompile=1 \
  "$@"
# NOTE: `--ccache` was dropped — upstream meson removed the setup flag
# (2026-09-03, meson 1.12.0.r154+); ccache still engages via compiler detection.
