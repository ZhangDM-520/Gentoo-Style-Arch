# Maintainer: Peter Jung <ptr1337@cachyos.org>
# Maintainer: asyync1024 <asyync1024 at proton dot me>

_reponame=mold
pkgname=${_reponame}-git
pkgver=2.42.0.r74.g92eb17a0
pkgrel=1
pkgdesc='A Modern Linker'
arch=('x86_64')
url="https://github.com/rui314/$_reponame"
license=('MIT')
# bundled: xxhash
depends=(
  glibc
  libblake3
  libstdc++
  mimalloc
  tbb
  zlib
  zstd
)
makedepends=(
  cmake
  ninja
  git
  mold
  python
)
source=("git+${url}.git")
b2sums=('SKIP')
provides=("$_reponame=$pkgver")
conflicts=("$_reponame")

pkgver() {
  cd "$_reponame"
  git describe --long --tags | sed -E 's/^v//;s/([^-]*-g)/r\1/;s/-/./g'
}

build() {
  local _cmake_options=(
    -S "$_reponame"
    -B build
    -G Ninja
    -W no-author
    -D CMAKE_BUILD_TYPE='Release'
    -D CMAKE_C_FLAGS_RELEASE='-DNDEBUG'
    -D CMAKE_CXX_FLAGS_RELEASE='-DNDEBUG'
    -D CMAKE_INSTALL_PREFIX='/usr'
    -D CMAKE_INSTALL_LIBEXECDIR='lib'
    -D MOLD_USE_SYSTEM_MIMALLOC=ON
    -D MOLD_USE_SYSTEM_TBB=ON
    -D MOLD_LTO=ON
    -D MOLD_USE_MOLD=ON
  )

  # Phase 1: instrumented build (LTO off for speed)
  msg "PGO Phase 1: instrumented build"
  cmake "${_cmake_options[@]}" \
    -D MOLD_LTO=OFF \
    -D CMAKE_C_FLAGS="-fprofile-generate=$(pwd)/pgo-profiles" \
    -D CMAKE_CXX_FLAGS="-fprofile-generate=$(pwd)/pgo-profiles" \
    -D CMAKE_EXE_LINKER_FLAGS="-fprofile-generate=$(pwd)/pgo-profiles" \
    -D CMAKE_SHARED_LINKER_FLAGS="-fprofile-generate=$(pwd)/pgo-profiles"
  cmake --build build

  # Phase 2: training — link mold's own object files
  # NOTE: write to a REAL temp file, not /dev/null — mold mmaps its output
  # file and a zero-size device file caused an infinite spin (4h+ at 13
  # cores without finishing a 1.9 GB link). Bounded by timeout: on timeout
  # no .gcda is written and the gcda_count check below falls back to a
  # plain LTO-only build.
  msg "PGO Phase 2: training by linking mold itself"
  (cd build && timeout -s INT -k 30 600 ./mold -o /tmp/mold-pgo-train-out CMakeFiles/mold.dir/src/*.o 2>/dev/null || true)
  rm -f /tmp/mold-pgo-train-out

  # Verify profile data
  # NOTE: -fprofile-generate=<dir> routes ALL .gcda files into that dir
  local gcda_count=$(find pgo-profiles -name '*.gcda' 2>/dev/null | wc -l)
  if [ "$gcda_count" -eq 0 ]; then
    warning "No profile data generated — falling back to LTO-only build"
    rm -rf build
    cmake "${_cmake_options[@]}"
    cmake --build build
    return 0
  fi
  msg "Profile data generated: $gcda_count .gcda files"

  # Phase 3: rebuild with profile + LTO
  # NOTE: do NOT delete pgo-profiles here — phase 3 needs it for -fprofile-use
  msg "PGO Phase 3: optimized build"
  rm -rf build
  cmake "${_cmake_options[@]}" \
    -D CMAKE_C_FLAGS="-DNDEBUG -fprofile-use=$(pwd)/pgo-profiles" \
    -D CMAKE_CXX_FLAGS="-DNDEBUG -fprofile-use=$(pwd)/pgo-profiles"
  cmake --build build
  rm -rf pgo-profiles
}

# check() removed 2026-09-04: full ctest suite is release-validation, not packaging

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$_reponame/LICENSE"
}
