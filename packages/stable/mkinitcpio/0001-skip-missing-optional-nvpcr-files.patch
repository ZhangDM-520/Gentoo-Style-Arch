From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gentoo_Style_Arch maintainers <maintainers@example.invalid>
Date: Thu, 17 Sep 2026 14:00:00 +0800
Subject: [PATCH] initcpio: skip absent optional NvPCR definitions

The systemd initcpio hook can run on systems whose systemd package does not
install NvPCR definitions, such as builds with the bootloader feature disabled.
An unmatched glob must not be passed to add_file as a literal path.
---
 install/sd-encrypt | 5 ++++-
 install/systemd    | 1 +
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/install/sd-encrypt b/install/sd-encrypt
--- a/install/sd-encrypt
+++ b/install/sd-encrypt
@@ -53 +53,4 @@
-    map add_file /usr/lib/nvpcr/*.nvpcr
+    for nvpcr in /usr/lib/nvpcr/*.nvpcr; do
+        [[ -f "$nvpcr" ]] || continue
+        add_file "$nvpcr"
+    done
diff --git a/install/systemd b/install/systemd
--- a/install/systemd
+++ b/install/systemd
@@ -215 +215,2 @@
-        add_file "$nvpcr"
+        [[ -f "$nvpcr" ]] || continue
+        add_file "$nvpcr"
--
2.53.0
