# FETCHED-ONLY — source names this recipe fetches at build time and keeps out
# of Git (see packages/stable/bash/.gitignore). One glob per line, matched
# against the source's basename; '#' lines and blank lines are ignored.
#
# The GNU patch files below are fetched by their source URLs and land beside
# the recipe as build state only. tests/recipe-sources.sh reads THIS file and
# excuses a matching name from its must-exist/must-be-committed checks, so the
# repo-wide walker no longer special-cases this recipe by name.
bash[0-9]*-[0-9]*
bash[0-9]*-[0-9]*.sig
