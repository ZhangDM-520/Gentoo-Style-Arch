### BUILD OPTIONS
# Set these variables to ANYTHING that is not null or choose proper variable to enable them

### Selecting CachyOS config
: "${_cachy_config:=yes}"

### Selecting the CPU scheduler
# ATTENTION - only one of the following values can be selected:
# 'bore' - select 'Burst-Oriented Response Enhancer'
# 'bmq' - select 'BMQ Scheduler' ## UNAVAILABLE: the 7.3 patch set ships no
#         sched/0001-prjc-cachy.patch, so prepare() aborts at parse time
# 'hardened' - select 'BORE Scheduler hardened' ## kernel with hardened config and hardening patches with the bore scheduler
#         ## UNAVAILABLE: the 7.3 patch set ships no misc/0001-hardened.patch
# 'cachyos' - select 'CachyOS Default Scheduler (EEVDF)'
# 'eevdf' - select 'EEVDF Scheduler'
# 'rt' - select EEVDF, but includes a series of realtime patches
# 'rt-bore' - select Burst-Oriented Response Enhancer, but includes a series of realtime patches
# 'muqss' - select 'MuQSS (Multiple Queue Skiplist) Scheduler' ## NOT combinable with PREEMPT_RT
#           (Kconfig: PREEMPT_RT depends on !SCHED_MUQSS)
#         ## UNAVAILABLE until 0001-muqss-cachy.patch is rebased onto _major: the
#         ## local copy targets 7.2, so prepare() aborts at parse time
#
# Unsupported values abort in prepare() before any patch is applied, with the
# missing patch named - a 404 halfway through the patch run is not a diagnosis.
: "${_cpusched:=rt-bore}"

### Tweak kernel options prior to a build via nconfig
: "${_makenconfig:=no}"

### Tweak kernel options prior to a build via xconfig
: "${_makexconfig:=no}"

# Compile ONLY used modules to VASTLYreduce the number of modules built
# and the build time.
#
# To keep track of which modules are needed for your specific system/hardware,
# give module_db script a try: https://aur.archlinux.org/packages/modprobed-db
# This PKGBUILD read the database kept if it exists
#
# More at this wiki page ---> https://wiki.archlinux.org/index.php/Modprobed-db
: "${_localmodcfg:=no}"

# Path to the list of used modules
: "${_localmodcfg_path:="$HOME/.config/modprobed.db"}"

# Use the current kernel's .config file
# Enabling this option will use the .config of the RUNNING kernel rather than
# the ARCH defaults. Useful when the package gets updated and you already went
# through the trouble of customizing your config options.  NOT recommended when
# a new kernel is released, but again, convenient for package bumps.
: "${_use_current:=no}"

### Enable KBUILD_CFLAGS -O3
: "${_cc_harder:=yes}"

### Set performance governor as default
: "${_per_gov:=no}"

### Select BBR as the default TCP congestion control
# Writes DEFAULT_TCP_CONG="bbr", DEFAULT_BBR and NET_SCH_FQ (and keeps CUBIC
# around as a module). It does NOT select a "BBRv3": CONFIG_TCP_CONG_BBR3
# existed in 7.2, is gone in 7.3, and was never referenced by this block - the
# old name _tcp_bbr3 was simply wrong.
# The old spelling still works, with a warning, because it appears in every
# downstream howto.
if [ -n "${_tcp_bbr3+set}" ] && [ -z "${_tcp_bbr+set}" ]; then
    _tcp_bbr="$_tcp_bbr3"
    printf '>>> WARNING: _tcp_bbr3 is deprecated and no longer names a BBRv3; use _tcp_bbr (carrying over %s)\n' "$_tcp_bbr" >&2
fi
: "${_tcp_bbr:=yes}"

### Running with a 1000HZ, 750Hz, 600 Hz, 500Hz, 300Hz, 250Hz and 100Hz tick rate
: "${_HZ_ticks:=300}"

## Choose between periodic, idle or full
### Full tickless can give higher performances in various cases but, depending on hardware, lower consistency.
: "${_tickrate:=idle}"

## Choose between full or lazy
# Full: Makes all non-critical kernel code preemptible to reduce latency
# Lazy: Same as full but instead of preempting immediately it waits for signals from the scheduler
#       in an attempt to boost throughput.
#       In practice, this doesn't seem to perform well as both throughput and latency suffer
#       compared to full.
#
# IGNORED under _cpusched=rt/rt-bore: those force the RT preemption model, so a
# PREEMPT/PREEMPT_LAZY choice cannot apply. Because the default is applied here
# rather than by the caller, "the caller asked for this" has to be recorded
# *before* the default lands - otherwise prepare() cannot tell a deliberate
# _preempt=full under rt-bore (a contradiction worth stopping for) from this
# file's own default (not a contradiction at all).
_preempt_explicit="${_preempt+set}"
: "${_preempt:=full}"

### Transparent Hugepages
# ATTENTION - one of two predefined values should be selected!
# 'always' - always enable THP
# 'madvise' - madvise, prevent applications from allocating more memory resources than necessary
# More infos here:
# https://access.redhat.com/documentation/en-us/red_hat_enterprise_linux/7/html/performance_tuning_guide/sect-red_hat_enterprise_linux-performance_tuning_guide-configuring_transparent_huge_pages
#
# UNAVAILABLE under _cpusched=rt/rt-bore: mm/Kconfig gates the entire THP menu
# (`menuconfig TRANSPARENT_HUGEPAGE`) on `!PREEMPT_RT`, so with PREEMPT_RT=y
# the symbols below do not exist in the tree at all. scripts/config writes them
# anyway and olddefconfig deletes them, with nothing reported. prepare() now
# prints the drop and the expectation table records !TRANSPARENT_HUGEPAGE, so
# the loss is a tested fact rather than an accident.
_hugepage_explicit="${_hugepage+set}"
: "${_hugepage:=madvise}"

# CPU compiler optimizations - Defaults to native if left empty
# - "native" (use compiler autodetection)
# - "zen4" (Use znver4 compiler optimizations)
# - "generic" (kernel's default - to share the package between machines with different CPU µarch as long as they are x86-64)
: "${_processor_opt:=native}"

# Clang LTO mode, only available with the "llvm" compiler - options are "none", "full" or "thin".
# ATTENTION - one of three predefined values should be selected!
# "full: uses 1 thread for Linking, slow and uses more memory, theoretically with the highest performance gains."
# "thin: uses multiple threads, faster and uses less memory, may have a lower runtime performance than Full."
# "thin-dist: Similar to thin, but uses a distributed model rather than in-process: https://discourse.llvm.org/t/rfc-distributed-thinlto-build-for-kernel/85934"
# "none: disable LTO
: "${_use_llvm_lto:=thin}"

# Use suffix -lto only when requested by the user
# Enabled by default.
# yes - enable -lto suffix
# no - disable -lto suffix
# https://github.com/CachyOS/linux-cachyos/issues/36
: "${_use_lto_suffix:=yes}"

# Use suffix -gcc when requested by the user
# This was added to facilitate https://github.com/CachyOS/linux-cachyos/issues/286
: "${_use_gcc_suffix:=no}"

# KCFI is a proposed forward-edge control-flow integrity scheme for
# Clang, which is more suitable for kernel use than the existing CFI
# scheme. kCFI doesn't require LTO, doesn't alter function references to
# point to a jump table, and won't break function address equality.
#
# NOTE: since 7.3 the user-selectable symbol is CONFIG_CFI; CONFIG_CFI_CLANG
# was demoted to a promptless `transitional` symbol that exists only to migrate
# an old .config, and ARCH_SUPPORTS_CFI_CLANG no longer exists. Writing the two
# old names was a silent no-op - measured: `-e ARCH_SUPPORTS_CFI_CLANG
# -e CFI_CLANG -e CFI_AUTO_DEFAULT` leaves CONFIG_CFI unset, while `-e CFI`
# selects it. prepare() writes CONFIG_CFI and the expectation table asserts it.
: "${_use_kcfi:=no}"

# Build the zfs module in to the kernel
# WARNING: The ZFS module doesn't build with selected RT sched due to licensing issues.
# If you use ZFS, refrain from building the RT kernel
: "${_build_zfs:=no}"

# Builds the open nvidia module and package it into a own base
# This does replace the requirement of nvidia-open-dkms
# Use this only if you have Turing+ GPU
: "${_build_nvidia_open:=no}"

# Builds the r8125 module and package it into its own package
# Replaces requirement for r8125-dkms
: "${_build_r8125:=no}"

# Build a debug package with non-stripped vmlinux. Esential for PGO training! make sure you disbaled strip.
: "${_build_debug:=yes}"

# Enable AUTOFDO_CLANG for the first compilation to create a kernel, which can be used for profiling
# Workflow:
# https://cachyos.org/blog/2411-kernel-autofdo/
# 1. Compile Kernel with _autofdo=yes and _build_debug=yes
# 2. Boot the kernel on your system and run a representative workload under perf (AMD Zen3+/4/5:
#    perf record --pfm-events RETIRED_TAKEN_BRANCH_INSTRUCTIONS:k -a -N -b -c 500009 -o kernel.data -- <workload>)
# 3. Convert the profile, see "Generating the Profile for AutoFDO":
#    create_llvm_prof --binary=/usr/src/debug/${pkgbase}/vmlinux --profile=kernel.data --format=extbinary --out=autofdo.afdo
# 4. Put the profile into this directory (next to the PKGBUILD)
# 5. Run kernel build again with _autofdo=yes and _autofdo_profile_name set to the profile filename
# Profiles are host-specific and intentionally disabled for a clean checkout.
# Enable them only after placing a matching profile beside this PKGBUILD.
#
# Drift, deliberate: these defaults are "no", so a build with them produces a
# kernel with AUTOFDO_CLANG and PROPELLER_CLANG unset. If you have previously
# built this recipe with either enabled, the default rebuild silently replaces
# an optimised kernel with a plain one - a real loss of optimisation that the
# build does not warn about. Two honest choices: drop the profile files beside
# this PKGBUILD and set _autofdo/_propeller to yes (keeping the optimisation),
# or accept the plain kernel. What must not happen is the swap passing
# unnoticed, which is why prepare() asserts the off state and prints it in the
# resolved-config diff.
: "${_autofdo:=no}"

# Name for the AutoFDO profile (a file in this directory)
: "${_autofdo_profile_name:=afdo.prof}"

# Propeller should be applied, after the kernel is optimized with AutoFDO
# Workflow:
# 1. Proceed with above AutoFDO Optimization, but enable at the final compilation also _propeller
# 2. Boot into the AutoFDO Kernel and profile it again (same perf command)
# 3. Convert the profile into the propeller profile, example:
#    create_llvm_prof --binary=/usr/src/debug/${pkgbase}/vmlinux --profile=propeller.data --format=propeller --propeller_output_module_name --out=propeller_cc_profile.txt --propeller_symorder=propeller_ld_profile.txt
# 4. Place the propeller_cc_profile.txt and propeller_ld_profile.txt into this directory
# 5. Enable _propeller_profiles
: "${_propeller:=no}"

# Enable this after the profiles have been generated
: "${_propeller_profiles:=no}"

### Crash-capture chain (opt-in)
# The shipped config argues against a usable crash-capture chain on every
# count: it sets EFI_VARS_PSTORE_DEFAULT_DISABLE=y and leaves PSTORE_CONSOLE,
# WQ_WATCHDOG, PANIC_ON_OOPS, BOOTPARAM_HARDLOCKUP_PANIC and
# BOOTPARAM_SOFTLOCKUP_PANIC unset. A kernel that panics then writes into a
# pstore the firmware-variable level has disabled, and a bootloader-less boot
# records nothing at all.
#
# Turning this on makes the config carry the chain itself instead of relying on
# the operator's kernel command line and sysctl drop-in. It is also a behaviour
# change: PANIC_ON_OOPS plus PANIC_TIMEOUT makes the kernel reboot on an oops
# rather than limp on, and WQ_WATCHDOG makes a workqueue item that never runs
# announce itself - the failure mode where a deferred irq_work cannot run
# because the CPU is hard-locked with IRQs off.
#
# WQ_WATCHDOG and PSTORE_CONSOLE are config-only: no command line can set them,
# which is what makes this knob worth having.
#
# BOOTPARAM_SOFTLOCKUP_PANIC is an *int* (0/1), not a bool, so `-e` would be a
# silent no-op; it is written with --set-val.
: "${_capture_chain:=no}"

### Host-derived tuning
# The shipped config carries MAXSMP=y - "maximum number of SMP processors and
# NUMA nodes", a server profile - together with NR_CPUS=8192 and
# CPUMASK_OFFSTACK=y, and enables ZSWAP. None of that suits a desktop or laptop,
# so this knob corrects it: MAXSMP off, NR_CPUS=_nr_cpus, ZSWAP off (zram is
# the mechanism where a swap device is wanted).
# With MAXSMP off the NR_CPUS range is [2, 512]; _nr_cpus is validated against
# that in prepare(). X86_AMD_PSTATE_DEFAULT_MODE is deliberately left at 3
# (Active/EPP), the mode that lets amd-pstate follow the platform's EPP hints.
: "${_host_tune:=yes}"
: "${_nr_cpus:=64}"

### Opt-in hardening profile
# Not a default: the stock values are already reasonable
# (INIT_ON_ALLOC_DEFAULT_ON, SLAB_FREELIST_RANDOM/HARDENED, HARDENED_USERCOPY,
# FORTIFY_SOURCE, RANDOMIZE_KSTACK_OFFSET_DEFAULT, X86_KERNEL_IBT and
# STRICT_KERNEL_RWX/STRICT_MODULE_RWX all on). This knob exists for a
# deliberate flip: init_on_free costs 3-8% and strict IOMMU DMA costs
# throughput on every unmap. CPU mitigation state is a command-line decision
# this recipe does not override.
: "${_hardened:=no}"

### Policy for features that cannot exist under _cpusched=rt/rt-bore
# Three knobs interact with the RT preemption model and until now each was
# dropped in silence: _hugepage (mm/Kconfig gates the THP menu on
# !PREEMPT_RT), _preempt (the RT model is forced) and _build_zfs (the CDDL-only
# ZFS module cannot be linked against a PREEMPT_RT kernel).
#
# 'abort' stops prepare() with a named reason when one of them was *explicitly*
# set to something that cannot happen. 'accept' downgrades that to a warning and
# records the loss as a negative expectation instead.
# A knob left at this file's own default is never fatal: otherwise the shipped
# default _cpusched=rt-bore together with the shipped default _hugepage=madvise
# would refuse to build.
: "${_rt_feature_drops:=abort}"

### Kernel major the local MuQSS patch was rebased onto
# Upstream dropped MuQSS from the patch set, so this recipe carries its own
# copy, built against 7.2; 7.3 does not carry one either. The variant gate
# refuses _cpusched=muqss unless this matches _major, so selecting it fails in
# seconds with a reason instead of halfway through prepare() with a patch
# reject. Bump it only after the patch has been verified to apply cleanly.
: "${_muqss_patch_major:=7.2}"

# ATTENTION: Do not modify after this line
_is_lto_kernel() {
    [[ "$_use_llvm_lto" = "thin" || "$_use_llvm_lto" = "full"  || "$_use_llvm_lto" = "thin-dist" ]]
    return $?
}

_is_ci_build() {
    [[ -n "$CI" || -n "$GITHUB_RUN_ID" ]]
    return $?
}

# The variant gate below runs at parse time, i.e. before makepkg's own helpers
# are necessarily in scope, so fall back to plain stderr when `error` is not
# defined yet.
_die() {
    if declare -F error >/dev/null; then error "$@"; else printf '==> ERROR: %s\n' "$*" >&2; fi
    exit 1
}

# A feature that cannot exist under the selected preemption model. Dies unless
# the caller has explicitly accepted the drop; the caller then performs it.
_rt_drop() {
    local what="$1" why="$2"
    if [ "$_rt_feature_drops" = "accept" ]; then
        warning "$what dropped: $why"
        warning "  accepted via _rt_feature_drops=accept; recorded as a negative expectation"
    else
        _die "$what cannot be combined with _cpusched=$_cpusched: $why
Set _rt_feature_drops=accept to build without it."
    fi
}

# Expectations that only hold for the non-MuQSS schedulers. The MuQSS patch
# demotes the shared choice members (HZ_300, PREEMPT, NO_HZ_IDLE, ...) to
# promptless symbols and drives its own *_NODEF twins instead, so asserting the
# plain names there would fail on a configuration that is working correctly.
_want_unless_muqss() {
    [ "$_cpusched" = "muqss" ] || _config_wants+=("$@")
}

if _is_lto_kernel && [ "$_use_lto_suffix" = "yes"  ]; then
    _pkgsuffix="cachyos-${_cpusched}-lto"
elif ! _is_lto_kernel && [ "$_use_gcc_suffix" = "yes" ]; then
    _pkgsuffix="cachyos-${_cpusched}-gcc"
else
    _pkgsuffix="cachyos-${_cpusched}"
fi

pkgbase="linux-$_pkgsuffix"
# Tracking the CachyOS release-candidate channel. The reason is a sched_ext
# hardlockup defect fixed in 7.3-rc1: on 7.1 <= v < 7.2.6 scx_hardlockup()
# deferred the sched_ext abort to an irq_work, which never runs on a hard-locked
# CPU with IRQs off, and the handler returned %true whenever sched_ext was
# loaded, suppressing the kernel's own hardlockup report. Bump _rcver and
# _tagrel together as CachyOS re-tags the RC; _minor only matters when the
# stable channel is selected again.
_major=7.3
_minor=0
#_minorc=$((_minor+1))
_rcver=rc3
pkgver=${_major}.${_rcver}
_tagrel=4
pkgrel=1
#_stable=${_major}.${_minor}
_stable=${_major}-${_rcver}
#_stablerc=${_major}-${_rcver}
_srctag=cachyos-${_major}-${_rcver}-${_tagrel}
_srcname=${_srctag}
pkgdesc='Linux Cachy Sauce Kernel by CachyOS with other patches and improvements'
_kernver="$pkgver-$pkgrel"
_kernuname="${pkgver}-${_pkgsuffix}"
arch=('x86_64')
url="https://github.com/CachyOS/linux-cachyos"
license=('GPL-2.0-only')
options=('!strip' '!debug' '!lto')
makedepends=(
  bc
  binutils
  cpio
  gettext
  glibc
  libelf
  libgcc
  openssl
  pahole
  perl
  python
  rust
  rust-bindgen
  rust-src
  tar
  xxhash
  xz
  zlib
  zstd
)

_patchsource="https://raw.githubusercontent.com/cachyos/kernel-patches/master/${_major}"
_nv_ver=615.71.09
_nv_pkg="NVIDIA-Linux-x86_64-${_nv_ver}"
_nv_open_pkg="NVIDIA-kernel-module-source-${_nv_ver}"
source=(
    "https://github.com/CachyOS/linux/releases/download/${_srcname}/${_srcname}.tar.gz"{,.asc}
    "config"
)
validpgpkeys=(
  E18447AC260021D31F3FF6C4C8A2A4774B8B63C4  # Eric Naim <dnaim@cachyos.org>
  E8B9AA39F054E30E8290D492C3C4820857F654FE  # Peter Jung <admin@ptr1337.dev>
)

# DKMS out-of-tree module fixes for clang-built kernels - always applied,
# regardless of the compiler/LTO selection
source+=("${_patchsource}/misc/dkms-clang.patch")

# LLVM makedepends
if _is_lto_kernel; then
    makedepends+=(clang llvm lld)
    BUILD_FLAGS=(
        CC=clang
        LD=ld.lld
        LLVM=1
        LLVM_IAS=1
    )
fi

# The ZFS module cannot be linked against a PREEMPT_RT kernel (CDDL-only module
# against GPL-only kernel symbols). This used to `unset _build_zfs` in silence,
# so a caller who asked for zfs got a kernel without it and no explanation.
if [[ "$_cpusched" = "rt" || "$_cpusched" = "rt-bore" ]]; then
    if [ "$_build_zfs" = "yes" ]; then
        _rt_drop "_build_zfs=yes" "the CDDL-only ZFS module cannot be linked against a PREEMPT_RT kernel"
    fi
    unset _build_zfs
fi

# ZFS support
if [ "$_build_zfs" = "yes" ]; then
    makedepends+=(git)
    source+=("git+https://github.com/cachyos/zfs.git#commit=71a9f9578616a90c3c14bb59629fb4d31bfd68d1")
fi


if [ "$_build_nvidia_open" = "yes" ]; then
    source+=("https://download.nvidia.com/XFree86/${_nv_open_pkg%"-$_nv_ver"}/${_nv_open_pkg}.tar.xz"
             "${_patchsource}/misc/nvidia/0001-fix-dsc-correct-RC-parameter-tables-to-match-VESA-DS.patch"
             "${_patchsource}/misc/nvidia/0002-fix-dp-add-Bigscreen-Beyond-VR-headset-to-WAR-databa.patch"
             "${_patchsource}/misc/nvidia/0003-Pass-dmem_cgroup_init-to-dmem_cgroup_register_region.patch")
fi

if [ "$_build_r8125" = "yes" ]; then
    source+=("git+https://github.com/aravance/r8125.git")
fi

# NOTE: AutoFDO/Propeller profiles are intentionally NOT in source[] - they
# are local training artifacts referenced from $startdir in prepare().
# Keeping them out of source[] means updpkgsums/makepkg -g never sees them
# and cannot mangle the checksums when a profile appears or disappears.

### Scheduler variant gate
# The patch set is version-scoped and not every scheduler has a patch for every
# _major: 7.3 ships sched/0001-bore-cachy.patch and nothing else, yet the source
# case below is still reachable for bmq, hardened and muqss whose patches are
# simply absent. Selecting one of those used to fail deep inside prepare()
# ("patch does not apply") after the download, or - for the RT-only i915 patch -
# build a kernel missing a fix nobody noticed was gone.
#
# Check it here instead, before anything is fetched or written, so the failure
# costs seconds and names the reason. This is also the only place that can tell
# the difference between "no patch for this _major" (a version problem) and "the
# value is not a scheduler at all" (a typo).
case "$_cpusched" in
    cachyos|bore|eevdf|rt|rt-bore)
        ;;   # handled by the source case and the prepare() scheduler case
    bmq)
        _die "_cpusched=bmq needs sched/0001-prjc-cachy.patch, which the ${_major} patch set does not ship: https://github.com/CachyOS/kernel-patches/tree/master/${_major}/sched" ;;
    hardened)
        _die "_cpusched=hardened needs misc/0001-hardened.patch, which the ${_major} patch set does not ship: https://github.com/CachyOS/kernel-patches/tree/master/${_major}/misc" ;;
    muqss)
        [ "$_muqss_patch_major" = "$_major" ] ||
            _die "_cpusched=muqss needs 0001-muqss-cachy.patch rebased onto ${_major}; the local copy targets ${_muqss_patch_major}. Rebase it, confirm it applies, then set _muqss_patch_major=${_major}." ;;
    *)
        _die "The value $_cpusched is invalid. Choose the correct one again." ;;
esac

## List of CachyOS schedulers
#
# The patch set is version-scoped ("${_patchsource}"), so every filename below
# has to be re-checked against the new tree on each version bump. The 7.3 set
# ships only sched/0001-bore-cachy.patch, misc/dkms-clang.patch and
# misc/nvidia/ - it has no sched/0001-prjc-cachy.patch, no
# misc/0001-hardened.patch and no misc/0001-rt-i915.patch.
case "$_cpusched" in
    cachyos|eevdf) ## EEVDF - the CachyOS tarball's own scheduler, no extra patch
        ;;
    bore|rt-bore|hardened) # CachyOS Scheduler (BORE)
        source+=("${_patchsource}/sched/0001-bore-cachy.patch");;&
    bmq) ## Project C Scheduler (no 7.3 patch exists - unavailable on 7.3)
        source+=("${_patchsource}/sched/0001-prjc-cachy.patch");;
    muqss) ## MuQSS Scheduler (Kconfig forbids combining it with PREEMPT_RT)
        # locally fixed copy (see provenance header inside the patch) - upstream
        # URL: https://raw.githubusercontent.com/CachyOS/kernel-patches/refs/heads/master/7.2/sched/0001-muqss-cachy.patch
        # Built against 7.2; the 7.3 set does not carry it either.
        source+=("0001-muqss-cachy.patch");;
    hardened) ## Hardened Patches (no 7.3 patch exists - unavailable on 7.3)
        source+=("${_patchsource}/misc/0001-hardened.patch");;
    rt|rt-bore) ## RT patches
        # CachyOS added misc/0001-rt-i915.patch to the 7.2 set on 2026-06-29 and
        # never carried it into 7.3. Their 7.3 RC PKGBUILD still names it, but
        # only in a branch its own default (_cpusched=cachyos) cannot reach, so
        # the reference is dead code there. The patch touches
        # drivers/gpu/drm/i915/ and kernel/ksysfs.c, so its absence affects
        # Intel GPUs only - the target here is AMD (amdgpu/radeon), which is
        # unaffected.
        ;;
esac

export KBUILD_BUILD_HOST=cachyos
export KBUILD_BUILD_USER="$pkgbase"
export KBUILD_BUILD_TIMESTAMP="$(date -Ru${SOURCE_DATE_EPOCH:+d @$SOURCE_DATE_EPOCH})"

prepare() {
    cd "$_srcname"

    echo "Setting version..."
    echo "-$pkgrel" > localversion.10-pkgrel
    echo "${pkgbase#linux}" > localversion.20-pkgname

    local src
    for patch in "${source[@]}"; do
        patch="${patch%%::*}"
        src="${patch##*/}"
        src="${src%.zst}"
        [[ $src = *.patch ]] || continue
        echo "Applying patch $src..."
        if [[ "$patch" == "${_patchsource}"/misc/nvidia/* ]]; then
            patch -Np1 < "../$src" -d "${srcdir}/${_nv_open_pkg}"
        else
            patch -Np1 < "../$src"
        fi
    done

    echo "Setting config..."
    cp ../config .config

    ### Expectation table
    # Every scripts/config write below records what it expects to appear in the
    # final .config. scripts/config cannot check that itself: it appends or
    # sed-replaces CONFIG_FOO=y without consulting Kconfig at all, so a symbol
    # that does not exist in this tree is a silent no-op and a symbol whose
    # `depends on` is unmet is written and then deleted by the next
    # olddefconfig. The table is verified once, after `make prepare`/`make
    # config`, and a mismatch aborts with the symbol, what was expected and what
    # actually landed (absent / n / a different value) - see verify-config.sh,
    # whose behaviour is pinned by tests/kernel-config-verify.sh.
    local -a _config_wants=()

    ### Optionally use running kernel's config
    # code originally by nous; http://aur.archlinux.org/packages.php?ID=40191
    # This replaces the entire base config, so it must run *before* the toggles
    # below rather than after them. At the end of the file it silently discarded
    # every knob the caller had set, which is why _use_current=yes produced a
    # kernel that ignored the whole option block.
    if [ "$_use_current" = "yes" ]; then
        if [[ -s /proc/config.gz ]]; then
            echo "Extracting config from /proc/config.gz..."
            # modprobe configs
            zcat /proc/config.gz > ./.config
        else
            # The original code printed three warnings and then ran a bare
            # `exit`, which returns the status of the last command (0) and so
            # let prepare() "succeed" with no config at all.
            _die "This kernel was not built with CONFIG_IKCONFIG_PROC, so /proc/config.gz does not exist and _use_current=yes cannot be honoured."
        fi
    fi

    ### Optionally load needed modules for the make localmodconfig
    # See https://aur.archlinux.org/packages/modprobed-db
    # `make localmodconfig` rewrites .config against the loaded module list, so
    # like _use_current it has to precede the toggles.
    if [ "$_localmodcfg" = "yes" ]; then
        if [ -e "$_localmodcfg_path" ]; then
            echo "Running Steven Rostedt's make localmodconfig now"
            make "${BUILD_FLAGS[@]}" LSMOD="${_localmodcfg_path}" localmodconfig
        else
            _die "No modprobed.db data found at $_localmodcfg_path"
        fi
    fi

    ### Select CPU optimization
    if [ -n "$_processor_opt" ]; then
        MARCH="${_processor_opt^^}"

        case "$MARCH" in
            GENERIC_V[1-4]) scripts/config -e GENERIC_CPU -d MZEN4 -d X86_NATIVE_CPU \
                --set-val X86_64_VERSION "${MARCH//GENERIC_V}"
                _config_wants+=(GENERIC_CPU=y MZEN4=n X86_NATIVE_CPU=n);;
            ZEN4) scripts/config -d GENERIC_CPU -e MZEN4 -d X86_NATIVE_CPU
                _config_wants+=(GENERIC_CPU=n MZEN4=y X86_NATIVE_CPU=n);;
            NATIVE) scripts/config -d GENERIC_CPU -d MZEN4 -e X86_NATIVE_CPU
                _config_wants+=(GENERIC_CPU=n MZEN4=n X86_NATIVE_CPU=y);;
        esac
    else
        scripts/config -d GENERIC_CPU -d MZEN4 -e X86_NATIVE_CPU
        _config_wants+=(GENERIC_CPU=n MZEN4=n X86_NATIVE_CPU=y)
    fi

    ### Selecting CachyOS config
    if [ "$_cachy_config" = "yes" ]; then
        echo "Enabling CachyOS config..."
        scripts/config -e CACHY
        _config_wants+=(CACHY=y)
    fi

    ### Selecting the CPU scheduler
    # BORE is not in the CachyOS tarball: sched/0001-bore-cachy.patch adds
    # `config SCHED_BORE` to init/Kconfig, and the source case only fetches that
    # patch for bore/hardened/rt-bore. cachyos is the tarball's own EEVDF
    # default and eevdf is plain EEVDF, so for those two the symbol does not
    # exist at all and `-e SCHED_BORE` was a silent no-op - which is why they
    # now record !SCHED_BORE instead of writing it.
    case "$_cpusched" in
        cachyos|eevdf)
            _config_wants+=(!SCHED_BORE);;
        bore|hardened) scripts/config -e SCHED_BORE
            _config_wants+=(SCHED_BORE=y);;
        bmq) scripts/config -e SCHED_ALT -e SCHED_BMQ;;
        muqss) scripts/config -e SCHED_MUQSS;;
        rt) scripts/config -e PREEMPT_RT
            _config_wants+=(PREEMPT_RT=y);;
        rt-bore) scripts/config -e SCHED_BORE -e PREEMPT_RT
            _config_wants+=(SCHED_BORE=y PREEMPT_RT=y);;
        *) _die "The value $_cpusched is invalid. Choose the correct one again.";;
    esac

    echo "Selecting ${_cpusched^^} CPU scheduler..."

    ### Enable KCFI
    if [ "$_use_kcfi" = "yes" ]; then
        echo "Enabling kCFI"
        # CONFIG_CFI is the user-selectable symbol since 7.3. ARCH_SUPPORTS_CFI_CLANG
        # no longer exists and CFI_CLANG is a promptless transitional symbol, so the
        # old three-name write was a silent no-op: CFI stayed unset.
        scripts/config -e CFI -e CFI_AUTO_DEFAULT
        _config_wants+=(CFI=y CFI_AUTO_DEFAULT=y)
    fi

    ### Select LLVM level
    case "$_use_llvm_lto" in
        thin) scripts/config -e LTO_CLANG_THIN
            _config_wants+=(LTO_CLANG_THIN=y);;
        thin-dist) scripts/config -e LTO_CLANG_THIN_DIST
            _config_wants+=(LTO_CLANG_THIN_DIST=y);;
        full) scripts/config -e LTO_CLANG_FULL
            _config_wants+=(LTO_CLANG_FULL=y);;
        none) scripts/config -e LTO_NONE
            _config_wants+=(LTO_NONE=y);;
        *) _die "The value '$_use_llvm_lto' is invalid. Choose the correct one again.";;
    esac

    echo "Selecting '$_use_llvm_lto' LLVM level..."

    # Toolchain-derived drop, recorded rather than asserted as a loss we chose:
    # X86_X32_ABI is gated on `depends on $(success,$(OBJCOPY) --version | head
    # -n1 | grep -qv llvm)` (arch/x86/Kconfig), so a clang/LLVM build cannot
    # have it. The shipped config asks for it and gets nothing.
    if _is_lto_kernel; then
        _config_wants+=(!X86_X32_ABI)
    fi

    if ! _is_lto_kernel; then
        echo "Enabling QR Code Panic for GCC Kernels"
        scripts/config --set-str DRM_PANIC_SCREEN qr_code -e DRM_PANIC_SCREEN_QR_CODE \
            --set-str DRM_PANIC_SCREEN_QR_CODE_URL https://panic.archlinux.org/panic_report# \
            --set-val CONFIG_DRM_PANIC_SCREEN_QR_VERSION 40
    fi

    ### Select tick rate
    case "$_HZ_ticks" in
        100|250|500|600|750|1000)
            scripts/config -d HZ_300 -e "HZ_${_HZ_ticks}" --set-val HZ "${_HZ_ticks}"
            _want_unless_muqss "HZ=${_HZ_ticks}" "HZ_${_HZ_ticks}=y" HZ_300=n;;
        300)
            scripts/config -e HZ_300 --set-val HZ 300
            _want_unless_muqss HZ=300 HZ_300=y;;
        *)
            _die "The value $_HZ_ticks is invalid. Choose the correct one again."
    esac

    echo "Setting tick rate to ${_HZ_ticks}Hz..."

    ### Select performance governor
    if [ "$_per_gov" = "yes" ]; then
        echo "Setting performance governor..."
        scripts/config -d CPU_FREQ_DEFAULT_GOV_SCHEDUTIL \
            -e CPU_FREQ_DEFAULT_GOV_PERFORMANCE
        # Same choice-member caveat as DEFAULT_CUBIC: the unselected member of
        # the governor choice can be absent rather than n.
        _config_wants+=(CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y !CPU_FREQ_DEFAULT_GOV_SCHEDUTIL)
    fi

    ### Select tick type
    case "$_tickrate" in
        periodic) scripts/config -d NO_HZ_IDLE -d NO_HZ_FULL -d NO_HZ -d NO_HZ_COMMON -e HZ_PERIODIC
            _want_unless_muqss HZ_PERIODIC=y NO_HZ_IDLE=n NO_HZ_FULL=n;;
        idle) scripts/config -d HZ_PERIODIC -d NO_HZ_FULL -e NO_HZ_IDLE  -e NO_HZ -e NO_HZ_COMMON
            _want_unless_muqss NO_HZ_IDLE=y HZ_PERIODIC=n NO_HZ_FULL=n;;
        full) scripts/config -d HZ_PERIODIC -d NO_HZ_IDLE -d CONTEXT_TRACKING_FORCE -e NO_HZ_FULL_NODEF -e NO_HZ_FULL -e NO_HZ -e NO_HZ_COMMON -e CONTEXT_TRACKING
            _want_unless_muqss NO_HZ_FULL=y HZ_PERIODIC=n NO_HZ_IDLE=n;;
        *) _die "The value '$_tickrate' is invalid. Choose the correct one again.";;
    esac

    echo "Selecting '$_tickrate' tick type..."

    ### Select preempt type

    # rt/rt-bore force the RT preemption model, so PREEMPT/PREEMPT_LAZY cannot
    # apply. This used to be a silent skip; it now only stays silent when the
    # caller left _preempt at this file's default.
    if [[ "$_cpusched" != "rt" && "$_cpusched" != "rt-bore" ]]; then
        case "$_preempt" in
            full) scripts/config -e PREEMPT -d PREEMPT_LAZY
                _want_unless_muqss PREEMPT=y PREEMPT_LAZY=n;;
            lazy) scripts/config -d PREEMPT -e PREEMPT_LAZY
                _want_unless_muqss PREEMPT=n PREEMPT_LAZY=y;;
            *) _die "The value '$_preempt' is invalid. Choose the correct one again.";;
        esac

        echo "Selecting '$_preempt' preempt type..."
    elif [ -n "$_preempt_explicit" ]; then
        _rt_drop "_preempt=$_preempt" "rt and rt-bore force the RT preemption model, so PREEMPT/PREEMPT_LAZY cannot apply"
    else
        echo "Leaving the preemption model to ${_cpusched^^} (rt forces it; _preempt was not set explicitly)..."
    fi

    ### MuQSS Kconfig overrides
    # The MuQSS patch renames the tick-rate, preemption and tick-type choice
    # members to *_NODEF and demotes the plain symbols (HZ_250, PREEMPT_LAZY,
    # NO_HZ_IDLE, ...) to silent (non-prompt) ones, whose .config values
    # olddefconfig ignores. The shared cases above would therefore be dead
    # code under SCHED_MUQSS (falling back to the MuQSS defaults of 100 Hz /
    # full preempt), so drive the *_NODEF members directly to make them
    # respect the _HZ_ticks / _preempt / _tickrate settings of this PKGBUILD.
    if [ "$_cpusched" = "muqss" ]; then
        case "$_HZ_ticks" in
            300) scripts/config -e HZ_300_NODEF
                 _config_wants+=(HZ_300_NODEF=y);;
            *)   scripts/config -e "HZ_${_HZ_ticks}_NODEF"
                 _config_wants+=("HZ_${_HZ_ticks}_NODEF=y");;
        esac
        for _hz in 100 250 300 500 600 750 1000; do
            [ "$_hz" = "$_HZ_ticks" ] || scripts/config -d "HZ_${_hz}_NODEF"
        done

        case "$_preempt" in
            full) scripts/config -e PREEMPT_NODEF -d PREEMPT_LAZY_NODEF
                  _config_wants+=(PREEMPT_NODEF=y PREEMPT_LAZY_NODEF=n);;
            lazy) scripts/config -e PREEMPT_LAZY_NODEF -d PREEMPT_NODEF
                  _config_wants+=(PREEMPT_LAZY_NODEF=y PREEMPT_NODEF=n);;
        esac

        case "$_tickrate" in
            periodic) scripts/config -e HZ_PERIODIC_NODEF -d NO_HZ_IDLE_NODEF -d NO_HZ_FULL_NODEF
                      _config_wants+=(HZ_PERIODIC_NODEF=y NO_HZ_IDLE_NODEF=n NO_HZ_FULL_NODEF=n);;
            idle)     scripts/config -e NO_HZ_IDLE_NODEF -d HZ_PERIODIC_NODEF -d NO_HZ_FULL_NODEF
                      _config_wants+=(NO_HZ_IDLE_NODEF=y HZ_PERIODIC_NODEF=n NO_HZ_FULL_NODEF=n);;
            full)     scripts/config -e NO_HZ_FULL_NODEF -d HZ_PERIODIC_NODEF -d NO_HZ_IDLE_NODEF
                      _config_wants+=(NO_HZ_FULL_NODEF=y HZ_PERIODIC_NODEF=n NO_HZ_IDLE_NODEF=n);;
        esac

        echo "Applying MuQSS overrides: ${_HZ_ticks}Hz, $_preempt preempt, $_tickrate tick..."
    fi

    ### Enable O3
    if [ "$_cc_harder" = "yes" ]; then
        echo "Enabling KBUILD_CFLAGS -O3..."
        scripts/config -d CC_OPTIMIZE_FOR_PERFORMANCE \
            -e CC_OPTIMIZE_FOR_PERFORMANCE_O3
        _config_wants+=(CC_OPTIMIZE_FOR_PERFORMANCE_O3=y CC_OPTIMIZE_FOR_PERFORMANCE=n)
    fi

    ### CI-only stuff
    # Note this deliberately *contradicts* the O3 and DEBUG_KERNEL settings above;
    # CI is the one place that is intended, so no expectations are recorded here.
    if _is_ci_build; then
        echo "Detected build inside CI"

        scripts/config \
            -d CC_OPTIMIZE_FOR_PERFORMANCE_O3 \
            -e CC_OPTIMIZE_FOR_SIZE \
            -d DEBUG_KERNEL \
            -e DEBUG_INFO_REDUCED
    fi

    ### Select BBR as the default congestion control
    if [ "$_tcp_bbr" = "yes" ]; then
        echo "Selecting BBR as the default TCP congestion control..."
        scripts/config -m TCP_CONG_CUBIC \
            -d DEFAULT_CUBIC \
            -e TCP_CONG_BBR \
            -e DEFAULT_BBR \
            --set-str DEFAULT_TCP_CONG bbr \
            -m NET_SCH_FQ_CODEL \
            -e NET_SCH_FQ \
            -d CONFIG_DEFAULT_FQ_CODEL \
            -e CONFIG_DEFAULT_FQ
        # DEFAULT_CUBIC is a member of the congestion-control choice whose
        # prompt is conditional; when another member is selected it is not
        # merely n, it is absent from the resolved config entirely (measured on
        # 7.3-rc3). `!DEFAULT_CUBIC` is the assertion that survives that.
        _config_wants+=(DEFAULT_TCP_CONG=bbr DEFAULT_BBR=y DEFAULT_FQ=y \
            TCP_CONG_BBR=y TCP_CONG_CUBIC=m NET_SCH_FQ=y NET_SCH_FQ_CODEL=m \
            !DEFAULT_CUBIC DEFAULT_FQ_CODEL=n)
    fi

    ### Select THP
    # mm/Kconfig gates the whole THP menu on !PREEMPT_RT, so under rt/rt-bore the
    # symbols below do not exist and these writes are discarded by olddefconfig.
    # Record the loss as a negative expectation instead of pretending.
    if [[ "$_cpusched" = "rt" || "$_cpusched" = "rt-bore" ]]; then
        if [ -n "$_hugepage_explicit" ]; then
            _rt_drop "_hugepage=$_hugepage" "mm/Kconfig gates TRANSPARENT_HUGEPAGE on !PREEMPT_RT, so the THP menu does not exist under $_cpusched"
        else
            warning "TRANSPARENT_HUGEPAGE is unavailable under _cpusched=$_cpusched (mm/Kconfig: depends on !PREEMPT_RT)."
            warning "  The default _hugepage=$_hugepage is therefore ignored; this is recorded as !TRANSPARENT_HUGEPAGE."
            warning "  Use a non-RT scheduler (_cpusched=cachyos|bore|eevdf) to get THP."
        fi
        _config_wants+=(!TRANSPARENT_HUGEPAGE !TRANSPARENT_HUGEPAGE_ALWAYS \
            !TRANSPARENT_HUGEPAGE_MADVISE)
    else
        case "$_hugepage" in
            always) scripts/config -d TRANSPARENT_HUGEPAGE_MADVISE -e TRANSPARENT_HUGEPAGE_ALWAYS
                _config_wants+=(TRANSPARENT_HUGEPAGE=y TRANSPARENT_HUGEPAGE_ALWAYS=y \
                    TRANSPARENT_HUGEPAGE_MADVISE=n);;
            madvise) scripts/config -d TRANSPARENT_HUGEPAGE_ALWAYS -e TRANSPARENT_HUGEPAGE_MADVISE
                _config_wants+=(TRANSPARENT_HUGEPAGE=y TRANSPARENT_HUGEPAGE_MADVISE=y \
                    TRANSPARENT_HUGEPAGE_ALWAYS=n);;
            *) _die "The value '$_hugepage' is invalid. Choose the correct one again.";;
        esac

        echo "Selecting '$_hugepage' TRANSPARENT_HUGEPAGE config..."
    fi

    ### Clang AutoFDO
    if [ "$_autofdo" = "yes" ]; then
        if ! _is_lto_kernel; then
            _die "AutoFDO requires the LLVM toolchain - set _use_llvm_lto to thin or full."
        fi
        echo "Enabling Clang AutoFDO..."
        scripts/config -e AUTOFDO_CLANG
        _config_wants+=(AUTOFDO_CLANG=y)
    fi

    if [ "$_autofdo" = "yes" ] && [ -n "$_autofdo_profile_name" ]; then
        if [ ! -e "${startdir}/${_autofdo_profile_name}" ]; then
            _die "AutoFDO profile '${_autofdo_profile_name}' not found in the PKGBUILD directory."
        fi
        echo "AutoFDO profile has been found..."
        BUILD_FLAGS+=(CLANG_AUTOFDO_PROFILE="${startdir}/${_autofdo_profile_name}")
    fi

    ### Propeller Optimization
    if [ "$_propeller" = "yes" ]; then
        echo "Enabling Propeller..."
        scripts/config -e PROPELLER_CLANG
        _config_wants+=(PROPELLER_CLANG=y)
    fi

    if [ "$_propeller" = "yes" ] && [ "$_propeller_profiles" = "yes" ]; then
        if [ ! -e "${startdir}/propeller_cc_profile.txt" ] || [ ! -e "${startdir}/propeller_ld_profile.txt" ]; then
            _die "Propeller profiles not found in the PKGBUILD directory (propeller_cc_profile.txt / propeller_ld_profile.txt)."
        fi
        echo "Propeller profile has been found..."
        BUILD_FLAGS+=(CLANG_PROPELLER_PROFILE_PREFIX="${startdir}/propeller")
    fi

    ### Crash-capture chain (opt-in)
    if [ "$_capture_chain" = "yes" ]; then
        echo "Wiring the crash-capture chain..."
        scripts/config -d EFI_VARS_PSTORE_DEFAULT_DISABLE \
            -e PSTORE_CONSOLE -e WQ_WATCHDOG \
            -e PANIC_ON_OOPS --set-val PANIC_TIMEOUT 10 \
            -e BOOTPARAM_HARDLOCKUP_PANIC --set-val BOOTPARAM_SOFTLOCKUP_PANIC 1 \
            --set-val MAGIC_SYSRQ_DEFAULT_ENABLE 0x1
        _config_wants+=(EFI_VARS_PSTORE_DEFAULT_DISABLE=n PSTORE_CONSOLE=y WQ_WATCHDOG=y \
            PANIC_ON_OOPS=y PANIC_TIMEOUT=10 BOOTPARAM_HARDLOCKUP_PANIC=y \
            BOOTPARAM_SOFTLOCKUP_PANIC=1 MAGIC_SYSRQ_DEFAULT_ENABLE=0x1)
    else
        # The shipped config already carries this state, so these writes are a
        # no-op today. They exist so the knob means the same thing in both
        # directions: `_capture_chain=no` is "the config must not carry the
        # chain", whatever a future config sync does to it. The assertions are
        # exact rather than `!SYM` because a renamed symbol must fail loudly
        # instead of reading as "already off".
        scripts/config -e EFI_VARS_PSTORE_DEFAULT_DISABLE \
            -d PSTORE_CONSOLE -d WQ_WATCHDOG -d PANIC_ON_OOPS \
            --set-val PANIC_TIMEOUT 0 -d BOOTPARAM_HARDLOCKUP_PANIC \
            --set-val BOOTPARAM_SOFTLOCKUP_PANIC 0 \
            --set-val MAGIC_SYSRQ_DEFAULT_ENABLE 0x0
        _config_wants+=(EFI_VARS_PSTORE_DEFAULT_DISABLE=y PSTORE_CONSOLE=n WQ_WATCHDOG=n \
            PANIC_ON_OOPS=n PANIC_TIMEOUT=0 BOOTPARAM_HARDLOCKUP_PANIC=n \
            BOOTPARAM_SOFTLOCKUP_PANIC=0 MAGIC_SYSRQ_DEFAULT_ENABLE=0x0)
    fi

    ### Host-derived tuning
    if [ "$_host_tune" = "yes" ]; then
        # MAXSMP off collapses NR_CPUS_RANGE_END to 512 (arch/x86/Kconfig:
        # CPUMASK_OFFSTACK selects 8192, otherwise 512), so an out-of-range
        # _nr_cpus would be silently clamped by Kconfig rather than rejected.
        if ! [[ "$_nr_cpus" =~ ^[0-9]+$ ]] || [ "$_nr_cpus" -lt 2 ] || [ "$_nr_cpus" -gt 512 ]; then
            _die "_nr_cpus must be an integer in [2, 512] (got '$_nr_cpus'); with MAXSMP disabled that is the range arch/x86/Kconfig accepts for NR_CPUS."
        fi
        echo "Applying host tuning (NR_CPUS=$_nr_cpus)..."
        scripts/config -d ZSWAP -d MAXSMP --set-val NR_CPUS "$_nr_cpus"
        # CPUMASK_OFFSTACK is selected by MAXSMP and disappears with it; it is
        # asserted as off rather than left to be discovered.
        _config_wants+=(ZSWAP=n MAXSMP=n "NR_CPUS=$_nr_cpus" !CPUMASK_OFFSTACK)
    fi

    ### Opt-in hardening profile
    if [ "$_hardened" = "yes" ]; then
        echo "Enabling the opt-in hardening profile..."
        scripts/config -d IOMMU_DEFAULT_DMA_LAZY -e IOMMU_DEFAULT_DMA_STRICT \
            -e INIT_ON_FREE_DEFAULT_ON -e BUG_ON_DATA_CORRUPTION
        _config_wants+=(INIT_ON_FREE_DEFAULT_ON=y BUG_ON_DATA_CORRUPTION=y \
            IOMMU_DEFAULT_DMA_STRICT=y IOMMU_DEFAULT_DMA_LAZY=n)
    fi

    ### Invariants
    # Not tied to any single knob: these are the properties the recipe assumes
    # hold for every supported configuration, and the ones a version bump can
    # break without any visible change. Asserting them costs nothing and turns
    # "the kernel silently lost sched_ext" into a named failure.
    _config_wants+=(
        # sched_ext: SCHED_CLASS_EXT depends on BPF_SYSCALL && BPF_JIT &&
        # DEBUG_INFO_BTF, so all three have to be asserted with it or the whole
        # sched_ext scheduler can vanish unnoticed.
        SCHED_CLASS_EXT=y BPF_SYSCALL=y BPF_JIT=y DEBUG_INFO_BTF=y
        # The diagnostics the crash-capture chain is built on.
        PSTORE=y EFI_VARS_PSTORE=y LOCKUP_DETECTOR=y HARDLOCKUP_DETECTOR=y \
        SOFTLOCKUP_DETECTOR=y MAGIC_SYSRQ=y PSI=y IKCONFIG_PROC=y
        # Amd-pstate mode 3 == Active (EPP); a version bump flipping this to 2
        # (Passive) or 4 (Guided) would quietly change the whole power/boost
        # behaviour.
        X86_AMD_PSTATE=y X86_AMD_PSTATE_DEFAULT_MODE=3 CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
        # Defaults that are already right, asserted so a bump cannot take them.
        SCHEDSTATS=y FTRACE_SYSCALLS=y SHUFFLE_PAGE_ALLOCATOR=y LRU_GEN=y LRU_GEN_ENABLED=y \
        SCHED_CORE=y PERF_EVENTS_AMD_UNCORE=m
        RANDOMIZE_BASE=y RANDOMIZE_MEMORY=y RANDOMIZE_KSTACK_OFFSET_DEFAULT=y \
        STACKPROTECTOR_STRONG=y FORTIFY_SOURCE=y HARDENED_USERCOPY=y \
        SLAB_FREELIST_RANDOM=y SLAB_FREELIST_HARDENED=y \
        STRICT_KERNEL_RWX=y STRICT_MODULE_RWX=y X86_KERNEL_IBT=y \
        SECURITY_LOCKDOWN_LSM=y CPU_MITIGATIONS=y INIT_ON_ALLOC_DEFAULT_ON=y \
        # SYSCTL replaced PROC_SYSCTL in 7.3 (fs/proc/Kconfig); the shipped
        # config still names the old symbol.
        SYSCTL=y
        # MODULE_SIG_FORCE must stay off: it would stop every unsigned
        # out-of-tree module from loading, and DKMS modules are a supported use
        # of this kernel.
        !MODULE_SIG_FORCE
    )
    # The hardening trio is off by default, so the assertion has to follow the
    # knob. It cannot live in the array above: `_hardened=yes` turns exactly
    # these three on, and an unconditional `!SYM` next to a toggle's `-e SYM` is
    # a contradiction that fails verification on a configuration the recipe
    # itself declares supported. (None of the three is RT-gated - measured:
    # INIT_ON_FREE_DEFAULT_ON depends only on !KMSAN, BUG_ON_DATA_CORRUPTION has
    # no depends, and IOMMU_DEFAULT_DMA_STRICT is an IOMMU_DEFAULT_* choice
    # member whose unselected form is emitted as `n`, so all three read back as
    # `n` and not as `absent`.)
    [ "$_hardened" = "yes" ] ||
        _config_wants+=(!INIT_ON_FREE_DEFAULT_ON !BUG_ON_DATA_CORRUPTION !IOMMU_DEFAULT_DMA_STRICT)
    # AutoFDO/Propeller drift. The recipe's default is both off, so a build that
    # previously enabled either quietly loses the optimisation; asserting the
    # off state records that swap in the log, and the assertion is skipped when
    # the knob asks for the feature - an invariant that contradicts its own
    # toggle would break the AutoFDO path instead.
    [ "$_autofdo" = "yes" ] || _config_wants+=(!AUTOFDO_CLANG)
    [ "$_propeller" = "yes" ] || _config_wants+=(!PROPELLER_CLANG)
    if [[ "$_cpusched" = "rt" || "$_cpusched" = "rt-bore" ]]; then
        _config_wants+=(!NUMA_BALANCING !QUEUED_RWLOCKS)
    else
        _config_wants+=(NUMA_BALANCING=y QUEUED_RWLOCKS=y)
    fi

    ### Rewrite configuration
    # "yes ''" also feeds "make prepare": syncconfig blocks on stdin prompts
    # whenever the patches introduce Kconfig symbols with unanswered questions
    # (e.g. MuQSS). Without it prepare() hangs waiting for user input.
    echo "Rewrite configuration..."
    yes "" | make "${BUILD_FLAGS[@]}" prepare
    yes "" | make "${BUILD_FLAGS[@]}" config >/dev/null
    diff -u ../config .config || :

    ### Verify the resolved configuration
    # This is the only step that can tell whether the toggles above actually
    # took effect: scripts/config cannot, and olddefconfig deletes a gated
    # symbol without a word. A failure here is fatal on purpose - shipping a
    # kernel whose options silently differ from the recipe's own declaration is
    # worse than not shipping one. `_config_wants` is built next to each write,
    # so this catches an unknown symbol (reported as `absent`), an unmet
    # `depends on` (reported as `n`) and a clobbered value alike.
    echo "Verifying ${#_config_wants[@]} configuration expectation(s)..."
    "${startdir}/verify-config.sh" .config "${_config_wants[@]}" ||
        _die "Configuration verification failed. A symbol this recipe sets does not exist in the ${_major} tree, is gated off by another option, or was overridden - see the failures above, and verify-config.sh for the expectation syntax."

    ### Prepared version
    make -s kernelrelease > version
    echo "Prepared $pkgbase version $(<version)"

    ### Running make nconfig
    [ "$_makenconfig" = "yes" ] && make "${BUILD_FLAGS[@]}" nconfig

    ### Running make xconfig
    [ "$_makexconfig" = "yes" ] &&  make "${BUILD_FLAGS[@]}" xconfig

    ### Save configuration for later reuse
    echo "Save configuration for later reuse..."
    local basedir="$(dirname "$(readlink "${srcdir}/config")")"
    cat .config > "${basedir}/config-${pkgver}-${pkgrel}${pkgbase#linux}"
}

_sign_modules() {
    msg2 "Signing modules in $1"
    local sign_script="${srcdir}/${_srcname}/scripts/sign-file"
    local sign_key="$(grep -Po 'CONFIG_MODULE_SIG_KEY="\K[^"]*' "${srcdir}/${_srcname}/.config")"
    if [[ ! "$sign_key" =~ ^/ ]]; then
        sign_key="${srcdir}/${_srcname}/${sign_key}"
    fi
    local sign_cert="${srcdir}/${_srcname}/certs/signing_key.x509"
    local hash_algo="$(grep -Po 'CONFIG_MODULE_SIG_HASH="\K[^"]*' "${srcdir}/${_srcname}/.config")"

    if [ "$_use_llvm_lto" != "none" ]; then
        local strip_bin="llvm-strip"
    else
        local strip_bin="strip"
    fi

    find "$1" -type f -name '*.ko' -print \
        -exec "${strip_bin}" --strip-debug '{}' \; \
        -exec "${sign_script}" "${hash_algo}" "${sign_key}" "${sign_cert}" '{}' \;
}

build() {
    cd "$_srcname"
    local _build_jobs="${GSA_BUILD_JOBS:-$(nproc)}"
    make "${BUILD_FLAGS[@]}" -j"$_build_jobs" all

    if ! _is_ci_build; then
        make -C tools/bpf/bpftool vmlinux.h feature-clang-bpf-co-re=1
    fi

    local MODULE_FLAGS=(
       KERNEL_UNAME="${_kernuname}"
       IGNORE_PREEMPT_RT_PRESENCE=1
       SYSSRC="${srcdir}/${_srcname}"
       SYSOUT="${srcdir}/${_srcname}"
    )

    if [ "$_build_nvidia_open" = "yes" ]; then
        cd "${srcdir}/${_nv_open_pkg}"
        MODULE_FLAGS+=(IGNORE_CC_MISMATCH=yes)
        CFLAGS= CXXFLAGS= LDFLAGS= make "${BUILD_FLAGS[@]}" "${MODULE_FLAGS[@]}" -j"$_build_jobs" modules
    fi

    if [ "$_build_zfs" = "yes" ]; then
        cd ${srcdir}/"zfs"

        local CONFIGURE_FLAGS=()
        [ "$_use_llvm_lto" != "none" ] && CONFIGURE_FLAGS+=("KERNEL_LLVM=1")

        ./autogen.sh
        sed -i "s|\$(uname -r)|${_kernuname}|g" configure
        ./configure "${CONFIGURE_FLAGS[@]}" --prefix=/usr --sysconfdir=/etc --sbindir=/usr/bin \
            --libdir=/usr/lib --datadir=/usr/share --includedir=/usr/include \
            --with-udevdir=/lib/udev --libexecdir=/usr/lib/zfs --with-config=kernel \
            --with-linux="${srcdir}/$_srcname"
        make "${BUILD_FLAGS[@]}"
    fi

    if [ "$_build_r8125" = "yes" ]; then
        cd "${srcdir}/r8125"
        make "${BUILD_FLAGS[@]}" KERNELDIR="$srcdir/$_srcname" modules
    fi

}

_package() {
    pkgdesc="The $pkgdesc kernel and modules"
    depends=('coreutils' 'kmod' 'initramfs')
    optdepends=('wireless-regdb: to set the correct wireless channels of your country'
                'linux-firmware: firmware images needed for some devices'
                'modprobed-db: Keeps track of EVERY kernel module that has ever been probed - useful for those of us who make localmodconfig'
                'scx-scheds: to use sched-ext schedulers')
    provides=(VIRTUALBOX-GUEST-MODULES WIREGUARD-MODULE KSMBD-MODULE V4L2LOOPBACK-MODULE NTSYNC-MODULE VHBA-MODULE ADIOS-MODULE)

    cd "$_srcname"

    local modulesdir="$pkgdir/usr/lib/modules/$(<version)"

    echo "Installing boot image..."
    # systemd expects to find the kernel here to allow hibernation
    # https://github.com/systemd/systemd/commit/edda44605f06a41fb86b7ab8128dcf99161d2344
    install -Dm644 "$(make -s image_name)" "$modulesdir/vmlinuz"

    # Used by mkinitcpio to name the kernel
    echo "$pkgbase" | install -Dm644 /dev/stdin "$modulesdir/pkgbase"

    echo "Installing modules..."
    ZSTD_CLEVEL=19 make "${BUILD_FLAGS[@]}" INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
        DEPMOD=/doesnt/exist  modules_install  # Suppress depmod

    # remove build links
    rm "$modulesdir"/build
}

_package-headers() {
    pkgdesc="Headers and scripts for building modules for the $pkgdesc kernel"
    depends=(binutils
      glibc
      libelf
      libgcc
      openssl
      pahole
      xxhash
      zlib
      zstd
     "${pkgbase}")
    provides=(LINUX-HEADERS)

    # the stripped vmlinux needs to be relinked when rebuilding out-of-tree modules
    if _is_lto_kernel; then
        depends+=(clang llvm lld)
    fi

    cd "${_srcname}"
    local builddir="$pkgdir/usr/lib/modules/$(<version)/build"

    echo "Installing build files..."
    install -Dt "$builddir" -m644 .config Makefile Module.symvers System.map \
        localversion.* version vmlinux

    if ! _is_ci_build; then
        install -Dt "$builddir" -m644 tools/bpf/bpftool/vmlinux.h
    fi

    install -Dt "$builddir/kernel" -m644 kernel/Makefile
    install -Dt "$builddir/arch/x86" -m644 arch/x86/Makefile
    cp -t "$builddir" -a scripts
    ln -srt "$builddir" "$builddir/scripts/gdb/vmlinux-gdb.py"

    # required when STACK_VALIDATION is enabled
    install -Dt "$builddir/tools/objtool" tools/objtool/objtool

    # required when DEBUG_INFO_BTF_MODULES is enabled
    if [ -f tools/bpf/resolve_btfids/resolve_btfids ]; then
        install -Dt "$builddir/tools/bpf/resolve_btfids" tools/bpf/resolve_btfids/resolve_btfids
    fi

    echo "Installing headers..."
    cp -t "$builddir" -a include
    cp -t "$builddir/arch/x86" -a arch/x86/include
    install -Dt "$builddir/arch/x86/kernel" -m644 arch/x86/kernel/asm-offsets.s

    install -Dt "$builddir/drivers/md" -m644 drivers/md/*.h
    install -Dt "$builddir/net/mac80211" -m644 net/mac80211/*.h

    # https://bugs.archlinux.org/task/13146
    install -Dt "$builddir/drivers/media/i2c" -m644 drivers/media/i2c/msp3400-driver.h

    # https://bugs.archlinux.org/task/20402
    install -Dt "$builddir/drivers/media/usb/dvb-usb" -m644 drivers/media/usb/dvb-usb/*.h
    install -Dt "$builddir/drivers/media/dvb-frontends" -m644 drivers/media/dvb-frontends/*.h
    install -Dt "$builddir/drivers/media/tuners" -m644 drivers/media/tuners/*.h

    # https://bugs.archlinux.org/task/71392
    install -Dt "$builddir/drivers/iio/common/hid-sensors" -m644 drivers/iio/common/hid-sensors/*.h

    echo "Installing KConfig files..."
    find . -name 'Kconfig*' -exec install -Dm644 {} "$builddir/{}" \;

    # Install .rmeta files if they exist
    if compgen -G "rust/*.rmeta" 1>/dev/null; then
        install -Dt "$builddir/rust" -m644 rust/*.rmeta
    fi

    # Install .so files if they exist
    if compgen -G "rust/*.so" 1>/dev/null; then
        install -Dt "$builddir/rust" rust/*.so
    fi

    echo "Installing unstripped VDSO..."
    make INSTALL_MOD_PATH="$pkgdir/usr" vdso_install \
      link=  # Suppress build-id symlinks

    echo "Removing unneeded architectures..."
    local arch
    for arch in "$builddir"/arch/*/; do
        [[ $arch = */x86/ ]] && continue
        echo "Removing $(basename "$arch")"
        rm -r "$arch"
    done

    echo "Removing documentation..."
    rm -r "$builddir/Documentation"

    echo "Removing broken symlinks..."
    find -L "$builddir" -type l -printf 'Removing %P\n' -delete

    echo "Removing loose objects..."
    find "$builddir" -type f -name '*.o' -printf 'Removing %P\n' -delete

    echo "Stripping build tools..."
    local file
    while read -rd '' file; do
        case "$(file -Sib "$file")" in
            application/x-sharedlib\;*)      # Libraries (.so)
                strip -v $STRIP_SHARED "$file" ;;
            application/x-archive\;*)        # Libraries (.a)
                strip -v $STRIP_STATIC "$file" ;;
            application/x-executable\;*)     # Binaries
                strip -v $STRIP_BINARIES "$file" ;;
            application/x-pie-executable\;*) # Relocatable binaries
                strip -v $STRIP_SHARED "$file" ;;
        esac
    done < <(find "$builddir" -type f -perm -u+x ! -name vmlinux -print0)

    echo "Stripping vmlinux..."
    strip -v $STRIP_STATIC "$builddir/vmlinux"

    echo "Adding symlink..."
    mkdir -p "$pkgdir/usr/src"
    ln -sr "$builddir" "$pkgdir/usr/src/$pkgbase"
}

_package-dbg(){
    pkgdesc="Non-stripped vmlinux file for the $pkgdesc kernel"
    depends=("${pkgbase}-headers")

    cd "${_srcname}"
    mkdir -p "$pkgdir/usr/src/debug/${pkgbase}"
    install -Dt "$pkgdir/usr/src/debug/${pkgbase}" -m644 vmlinux
}

_package-zfs(){
    pkgdesc="zfs module for the $pkgdesc kernel"
    depends=('pahole' "${pkgbase}=${_kernver}")
    provides=('ZFS-MODULE')
    license=('CDDL')

    cd "$_srcname"
    local modulesdir="$pkgdir/usr/lib/modules/$(<version)/extramodules"

    cd "${srcdir}/zfs"
    install -dm755 "${modulesdir}"
    install -m644 module/*.ko "${modulesdir}"

    _sign_modules "${modulesdir}"
    find "$pkgdir" -name '*.ko' -exec zstd --rm -19 -T0 {} +
    #  sed -i -e "s/EXTRAMODULES='.*'/EXTRAMODULES='${pkgver}-${pkgbase}'/" "$startdir/zfs.install"
}

_package-nvidia-open(){
    pkgdesc="nvidia open modules of ${_nv_ver} driver for the ${pkgbase} kernel"
    depends=("$pkgbase=$_kernver" "nvidia-utils=${_nv_ver}" "libglvnd")
    provides=('NVIDIA-MODULE')
    conflicts=("$pkgbase-nvidia")
    license=('MIT AND GPL-2.0-only')

    cd "$_srcname"
    local modulesdir="$pkgdir/usr/lib/modules/$(<version)/extramodules"

    cd "${srcdir}/${_nv_open_pkg}"
    install -dm755 "${modulesdir}"
    install -m644 kernel-open/*.ko "${modulesdir}"
    install -Dt "$pkgdir/usr/share/licenses/${pkgname}" -m644 COPYING

    _sign_modules "${modulesdir}"
    find "$pkgdir" -name '*.ko' -exec zstd --rm -19 -T0 {} +
}

_package-r8125() {
    pkgdesc="r8125 modules for the $pkgbase kernel"
    depends=("$pkgbase=$_kernver")
    license=('GPL-2.0-only')

    cd "$_srcname"
    local modulesdir="$pkgdir/usr/lib/modules/$(<version)/extramodules"

    cd "${srcdir}/r8125"
    install -dm755 "${modulesdir}"
    install -m644 src/*.ko "${modulesdir}"

    _sign_modules "${modulesdir}"
    find "$pkgdir" -name '*.ko' -exec zstd --rm -19 -T0 {} +

    # Blacklist r8169 so that r8125 is used instead
    install -dm755 "${pkgdir}/usr/lib/modprobe.d"
    echo "install r8169 /usr/bin/modprobe r8125 || /usr/bin/modprobe --ignore-install r8169" > "${pkgdir}/usr/lib/modprobe.d/${pkgname}.conf"
}

pkgname=("$pkgbase")
[ "$_build_debug" = "yes" ] && pkgname+=("$pkgbase-dbg")
pkgname+=("$pkgbase-headers")
[ "$_build_zfs" = "yes" ] && pkgname+=("$pkgbase-zfs")
[ "$_build_nvidia_open" = "yes" ] && pkgname+=("$pkgbase-nvidia-open")
[ "$_build_r8125" = "yes" ] && pkgname+=("$pkgbase-r8125")
for _p in "${pkgname[@]}"; do
    eval "package_$_p() {
    $(declare -f "_package${_p#$pkgbase}")
    _package${_p#$pkgbase}
    }"
done

